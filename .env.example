# ========================================
# Smart Buy Sentinel - Environment Variables
# ========================================
# Copie ce fichier en ".env" et remplissez avec vos valeurs
# cp .env.example .env
# 
# ⚠️ NE COMMITEZ JAMAIS le fichier .env dans Git!
# Il contient des secrets sensibles.
# ========================================

# =========== APACHE AIRFLOW ===========
# UID du processus Airflow (sur Linux)
#AIRFLOW_UID=50000

# Mot de passe PostgreSQL pour la base Airflow
# Changez pour quelque chose de sécurisé!
#AIRFLOW_DB_PASSWORD=changez_moi_pour_un_mot_de_passe_securise_123

# Clé secrète pour Airflow WebServer (32+ caractères)
# Générer avec: python -c "import secrets; print(secrets.token_urlsafe(32))"
#AIRFLOW__WEBSERVER__SECRET_KEY=changez_moi_pour_une_cle_secrete_very_long_32_chars_min

# Mot de passe admin Airflow UI
#AIRFLOW_ADMIN_PASSWORD=admin123

# =========== POSTGRESQL ===========
# Credentials pour la base de données métier (Smart Buy)
#POSTGRES_DB_USER=smart_buy_user
#POSTGRES_DB_PASSWORD=changez_moi_pour_postgres_mot_de_passe_123

# URL de connexion complète (utilisée par Spark, dbt, Streamlit)
# Format: postgresql://utilisateur:mot_de_passe@host:port/base_de_donnees
#DB_URL=postgresql://smart_buy_user:changez_moi_pour_postgres_mot_de_passe_123@postgres_data:5432/smart_buy_db

# =========== TELEGRAM BOT (OPTIONNEL) ===========
# Pour recevoir les alertes de deals par Telegram
# 1. Créer un bot avec @BotFather sur Telegram
# 2. Obtenir le TOKEN
# 3. Obtenir votre CHAT_ID avec /start ou @userinfobot

#TELEGRAM_TOKEN=123456789:ABCDefGHijKlMnOpQrStUvWxYz123456789_changez_moi
#TELEGRAM_CHAT_ID=987654321_changez_moi

# =========== TIMEZONE ===========
# Fuseau horaire pour Airflow
# Exemples: Europe/Paris, Europe/London, America/New_York, Asia/Tokyo
#TZ=Europe/Paris

# =========== SPARK CONFIGURATION (OPTIONNEL) ===========
# Memory allocation for Spark workers
#SPARK_WORKER_MEMORY=1G
#SPARK_WORKER_CORES=1

# =========== MODE DEBUG (À mettre à false en production) ===========
# Affiche logs verbeux
#DEBUG=false
