##### Smart Buy Sentinel - Infrastructure Gitignore #####

# --- SÉCURITÉ & SECRETS (CRITIQUE) ---
.env
*.env
auth_*.json
secrets/

# --- DONNÉES / DATA (Garde la structure, ignore les fichiers de données) ---
*.db
*.sqlite
/postgres_data/

# Ignorer TOUS les fichiers de données n'importe où dans le projet
*.csv
*.json
*.parquet
*.avro

# --- PYTHON & JUPYTER ---
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/
.virtualenv/
venv/
ENV/

# --- APACHE AIRFLOW ---
*.log
logs/
/airflow/logs/
/airflow/dags/__pycache__/
airflow_webserver_config.pid
airflow_config.py
webserver_config.py

# --- dbt (DATA BUILD TOOL) ---
target/
dbt_project/target/
dbt_modules/
dbt_packages/

# --- STREAMLIT ---
.streamlit/cache/
.streamlit/config.toml